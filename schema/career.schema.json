    },
    "shop": {
     "type": [
      "object",
      "null"
     ],
     "description": "商店购入通道（美食商店 1 层）；植物源调料为 null",
     "additionalProperties": false,
     "required": [
      "currency",
      "price",
      "buy_limit"
     ],
     "properties": {
      "currency": {
       "$ref": "#/definitions/currencyCode"
      },
      "price": {
       "type": "integer",
       "minimum": 0
      },
      "buy_limit": {
       "type": "integer",
       "minimum": 0
      },
      "unlock_career_lv": {
       "type": [
        "integer",
        "null"
       ],
       "minimum": 1,
       "description": "解锁所需烹饪艺术家职业等级序；null = 无解锁条件"
      }
     }
    },
    "plant": {
     "type": [
      "object",
      "null"
     ],
     "description": "植物自种通道（植物源调料：绽放档收获物）；商店材料为 null",
     "additionalProperties": false,
     "required": [
      "herb_id",
      "tier"
     ],
     "properties": {
      "herb_id": {
       "type": "integer",
       "minimum": 1,
       "description": "→ plants[].herb_id"
      },
      "tier": {
       "type": "integer",
       "minimum": 1,
       "maximum": 4,
       "description": "所需植物品质档（实测植物源调料均为 4 = 绽放档）"
      }
     }
    }
   }
  }
