    },
    "herb_id": {
     "type": "integer",
     "minimum": 1,
     "description": "→ plants[].herb_id（种子与植物一一对应）"
    },
    "i18n": {
     "type": "object",
     "additionalProperties": false,
     "required": [
      "zh",
      "en"
     ],
     "properties": {
      "zh": {
       "$ref": "#/definitions/entityText"
      },
      "en": {
       "$ref": "#/definitions/entityText"
      }
     }
    },
    "icon": {
     "type": [
      "string",
      "null"
     ],
     "pattern": "^images/[^/]+\\.png$",
     "description": "种子图标（images/ 内）"
    },
    "currency": {
     "$ref": "#/definitions/currencyCode",
     "description": "购入币种（实测 2 颗宝石计价：嗅幻草/红火焰藻，限购 5）"
    },
    "price": {
     "type": "integer",
     "minimum": 0,
